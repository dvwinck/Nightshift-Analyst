# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nightshift_analyst

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=Nightshift Analyst
APP_VERSION=0.1.0
# Local development only. In production set DEBUG=false and real secrets (32+ chars):
# the app refuses to start with placeholder keys when DEBUG is off.
DEBUG=true
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
